{
  "format": "VanillaInstance",
  "formatVersion": 1,
  "objects": {
    "OrbitLight": {
      "type": "script",
      "name": "Orbit Light",
      "parent": "scripts",
      "scriptType": "Server",
      "runWhen": "simulation",
      "language": "vanillalua",
      "source": "# Orbit Light: a warm point light circles the origin and lights the scene as it moves.\n# Move the light by changing the path values, or make it higher with the y value below.\ncall Scripts\ncall World\nget Instance\n\nlocal light = Instance.create(\"light\", World)\nlight.Name = \"OrbitLight\"\nlight.Color = \"#ffcf6b\"\nlight.Brightness = 2\nlight.Range = 16\nlight.CastShadows = True\n\nlocal path = {\n    {4, 0}, {3.7, 1.5}, {2.8, 2.8}, {1.5, 3.7},\n    {0, 4}, {-1.5, 3.7}, {-2.8, 2.8}, {-3.7, 1.5},\n    {-4, 0}, {-3.7, -1.5}, {-2.8, -2.8}, {-1.5, -3.7},\n    {0, -4}, {1.5, -3.7}, {2.8, -2.8}, {3.7, -1.5}\n}\n\nlocal index = 1\nprint(\"Orbit Light running.\")\n\nwhile True do\n    local point = path[index]\n    light.Position = vanilla3D.Position(point[1], 3, point[2])\n    index = index + 1\n    if index > 16 then\n        index = 1\n    end\n    wait(0.18)\nend\n"
    }
  }
}
