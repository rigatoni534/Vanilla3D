{
  "format": "VanillaInstance",
  "formatVersion": 1,
  "objects": {
    "PlayerStats": {
      "type": "frame",
      "name": "PlayerStats",
      "parent": "ui",
      "posX": 15, "posY": 82, "sizeX": 26, "sizeY": 18,
      "visible": true, "color": "#10141d", "transparency": 0.25,
      "borderWidth": 1, "borderColor": "#2e3441", "backgroundBlur": 6, "borderBlur": 0, "clipChildren": false
    },
    "PlayerName": {
      "type": "text",
      "name": "PlayerName",
      "parent": "PlayerStats",
      "posX": 50, "posY": 13, "sizeX": 88, "sizeY": 14,
      "visible": true, "text": "Player", "textColor": "#eceef3", "textSize": 18, "bold": true, "align": "Left"
    },
    "HealthLabel": {
      "type": "text",
      "name": "HealthLabel",
      "parent": "PlayerStats",
      "posX": 50, "posY": 34, "sizeX": 88, "sizeY": 9,
      "visible": true, "text": "HEALTH", "textColor": "#7d8798", "textSize": 11, "bold": false, "align": "Left"
    },
    "Health": {
      "type": "progressbar",
      "name": "Health",
      "parent": "PlayerStats",
      "posX": 50, "posY": 47, "sizeX": 88, "sizeY": 9,
      "visible": true, "color": "#1c2230", "transparency": 0.2, "backgroundBlur": 0,
      "shape": "Straight", "length": 100, "fillColor": "#ef6b6b", "fillTransparency": 0, "fillBlur": 0
    },
    "StaminaLabel": {
      "type": "text",
      "name": "StaminaLabel",
      "parent": "PlayerStats",
      "posX": 50, "posY": 64, "sizeX": 88, "sizeY": 9,
      "visible": true, "text": "STAMINA", "textColor": "#7d8798", "textSize": 11, "bold": false, "align": "Left"
    },
    "Stamina": {
      "type": "progressbar",
      "name": "Stamina",
      "parent": "PlayerStats",
      "posX": 50, "posY": 77, "sizeX": 88, "sizeY": 9,
      "visible": true, "color": "#1c2230", "transparency": 0.2, "backgroundBlur": 0,
      "shape": "Straight", "length": 100, "fillColor": "#4ed08a", "fillTransparency": 0, "fillBlur": 0
    },
    "HandleBars": {
      "type": "script",
      "name": "HandleBars",
      "parent": "PlayerStats",
      "scriptType": "Local",
      "runWhen": "simulation",
      "language": "vanillalua",
      "source": "# HandleBars: shows the player's name, health and stamina.\ncall Scripts\ncall Players\nget Instance\n\nplayer = Players.LocalPlayer\nhp = script.Parent.Health\nstamina = script.Parent.Stamina\nplayerName = script.Parent.PlayerName\n\nhp.Length = 0\nstamina.Length = 0\nplayerName.Text = player.Name\n\nfunction refresh()\n    local character = player.Character\n    if character ~= nil then\n        local human = character.Human\n        if human ~= nil then\n            hp.Length = human.Health / human.MaxHealth * 100\n            stamina.Length = human.Stamina / human.MaxStamina * 100\n        end\n    end\nend\n\nfunction setup(character)\n    local human = character.Human\n    if human ~= nil then\n        refresh()\n        human.HealthChanged:Connect(refresh)\n        human.StaminaChanged:Connect(refresh)\n    end\nend\n\nplayer.ModelAdded:Connect(setup)\nif player.Character then setup(player.Character) end\n"
    }
  }
}
